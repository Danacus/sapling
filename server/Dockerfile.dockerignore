# BuildKit reads `<dockerfile>.dockerignore` in preference to the context's
# `.dockerignore`, which is what keeps this out of the repo root — the root is
# the app's, and the Cloudflare Pages build must not grow files it doesn't need.
#
# The Dockerfile COPYs explicit paths anyway; this only keeps the context small.
*
!server/package.json
!server/pnpm-lock.yaml
!server/pnpm-workspace.yaml
!server/tsconfig.json
!server/src
!server/scripts
# Only the shared envelope file — the rest of src/lib/sync/ is app code.
!src/lib/sync/events.ts
# The root package.json carries `"type": "module"`, which decides events.ts's
# emit format under nodenext (see the Dockerfile).
!package.json
server/src/**/*.test.ts
