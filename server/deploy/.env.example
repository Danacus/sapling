# Copy to .env next to compose.yaml and fill in.

# The domain Caddy serves; needs an A/AAAA record pointing at this VPS
# before first start, or the certificate fetch fails.
SAPLING_DOMAIN=sync.example.com

# Exact browser origins allowed to call the API, comma-separated. Must
# include the app's origin; add http://localhost:5173 to sync from dev.
SAPLING_ORIGINS=https://sapling.pages.dev
