{
	"name": "sapling-sync-server",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"description": "Self-hosted event-log sync service for Sapling (see ../docs/sync.md)",
	"scripts": {
		"dev": "tsx watch src/index.ts",
		"build": "tsc -p tsconfig.json",
		"start": "node dist/server/src/index.js",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "vitest run",
		"test:watch": "vitest",
		"new-key": "tsx scripts/new-key.ts"
	},
	"dependencies": {
		"@hono/node-server": "^1.14.0",
		"better-sqlite3": "^12.0.0",
		"hono": "^4.7.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@types/better-sqlite3": "^7.6.12",
		"@types/node": "^22.13.0",
		"tsx": "^4.19.0",
		"typescript": "^6.0.3",
		"vitest": "^4.1.11"
	}
}
