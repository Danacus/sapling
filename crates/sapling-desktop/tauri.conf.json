{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Sapling",
	"version": "0.0.1",
	"identifier": "app.sapling.desktop",
	"build": {
		"frontendDist": "../../build",
		"devUrl": "http://localhost:5173",
		"beforeDevCommand": {
			"script": "pnpm dev",
			"cwd": "../..",
			"wait": false
		},
		"beforeBuildCommand": {
			"script": "pnpm build",
			"cwd": "../.."
		}
	},
	"app": {
		"windows": [
			{
				"title": "Sapling",
				"width": 1100,
				"height": 820,
				"minWidth": 360,
				"minHeight": 480
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": false,
		"icon": ["../../static/icons/icon-512.png"]
	}
}
