<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Dictation. wry's own `RustWebChromeClient.onPermissionRequest` already
      answers the WebView's `android.webkit.resource.AUDIO_CAPTURE` request by
      launching a runtime request for exactly these two and granting the page
      only if *both* come back — so no `MainActivity` override is needed, but
      both must be declared here or the system denies them without a prompt and
      `getUserMedia` fails with nothing shown to the learner. `RECORD_AUDIO` is
      the dangerous one; `MODIFY_AUDIO_SETTINGS` is normal and granted at
      install, but an undeclared normal permission is denied like any other and
      wry's callback fails the whole request on it.

      Nothing is recorded outside a press of the microphone button, and nothing
      captured leaves the device: the samples go to the app's own recognizer
      over the IPC (`crates/sapling-desktop/src/asr/`).
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!--
      So a device with no microphone can still install the app: dictation
      degrades to typing, which is what `$lib/asr` does everywhere else too.
    -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.sapling_desktop"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
