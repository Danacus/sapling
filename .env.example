# Copy to `.env` for local development. `.env` is gitignored; this file is the
# template, and both variables in it are build-time only.
#
# Build-time means Vite inlines them into the bundle: the deployed app gets its
# values from the GitHub repository's variables (see .github/workflows/deploy.yml),
# never from a file in the repo, and changing one never affects a build that
# already exists.
#
# The default below points at `pnpm sync:dev`'s throwaway localhost backend,
# so you can pair two browser profiles and watch them converge without
# touching real data. Point it at https://sapling-sync.vanoverloop.xyz instead
# to run against the real backend — which means the real library, so be
# deliberate about it.
#
# Unset entirely, the app has no sync at all: no network code is reachable and
# Settings says so. That is the default and a supported configuration.
VITE_SYNC_URL=http://localhost:8787

# The hosted YouTube page (`embed/`, deployed to its own origin), used by the
# **desktop shell only**: the app there is served from `tauri://localhost`, for
# which a browser sends no referer, and YouTube's player refuses to configure
# without one (error 153). The browser build has a real origin already and never
# reads this.
#
# Unset is supported and is what the web build ships with. Unset in a *desktop*
# build — `pnpm desktop:dev` included, which takes the same path on purpose —
# YouTube texts say so in the video's place and the text is still readable.
# To work on that path locally, run `pnpm embed:dev` and point this at it, e.g.
# VITE_YOUTUBE_EMBED_URL=http://localhost:5174/youtube.html
VITE_YOUTUBE_EMBED_URL=
