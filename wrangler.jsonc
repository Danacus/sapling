{
	// The sync backend. Deployed separately from the app: Cloudflare Pages still
	// builds and serves the SPA from git on every push to the default branch,
	// and this Worker is pushed on its own with `pnpm sync:deploy`. Keeping them
	// apart leaves `static/_headers` and `static/_redirects` — and the two
	// caching incidents they encode — exactly as they are.
	//
	// See `worker/index.ts` for what it does.
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "sapling-sync",
	"main": "worker/index.ts",
	"compatibility_date": "2026-08-01",
	"observability": { "enabled": true },

	// The public address, and the one the app is built against
	// (`VITE_SYNC_URL`). Declared here rather than left in the dashboard so it
	// is versioned and survives the Worker being recreated: `wrangler deploy`
	// provisions the domain and its certificate, and a Custom Domain sends every
	// path on the hostname to this Worker. It creates a Cloudflare-managed DNS
	// record rather than an ordinary A/CNAME, so the DNS tab showing nothing
	// editable is expected — the hostname resolving is the real test.
	"routes": [{ "pattern": "sapling-sync.vanoverloop.xyz", "custom_domain": true }],

	// One Durable Object per room, keyed by the hash of a pairing phrase. The
	// log lives in the DO's own SQLite: no D1, nothing else to provision, and it
	// is on the free plan.
	"durable_objects": {
		"bindings": [{ "name": "SYNC_ROOM", "class_name": "SyncRoom" }]
	},

	// `v1` stays as it is — a migration tag that has already run may never be
	// edited. `v2` replaces the LiveStore-era class with `SyncRoom`; deleting
	// `SyncBackendDO` drops the log it held, which the v3 export file is the
	// copy of.
	"migrations": [
		{ "tag": "v1", "new_sqlite_classes": ["SyncBackendDO"] },
		{ "tag": "v2", "new_sqlite_classes": ["SyncRoom"], "deleted_classes": ["SyncBackendDO"] }
	]
}
